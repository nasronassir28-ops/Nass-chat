rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function chatMembers(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }
    function isMember(chatId) { return authed() && request.auth.uid in chatMembers(chatId); }

    match /users/{uid} {
      allow read: if authed();
      allow create, update: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','nameLower','photo','createdAt','pub','kb','blocked','deleted','email','emailLower'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 30))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 60000));
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if authed() && request.auth.uid in resource.data.participants;
      allow create: if authed()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.hasAll(chatId.split('_'));
      allow update: if authed()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId','text','image','file','time','read','v','iv','ct','deleted','reactions','id','callerId','calleeId','kind','state','offer','answer','callerIce','calleeIce','restart','answerRestart','chunk','data']);
        allow update: if isMember(chatId)
          && request.resource.data.keys().hasOnly(['senderId','text','image','file','time','read','v','iv','ct','deleted','reactions','id','callerId','calleeId','kind','state','offer','answer','callerIce','calleeIce','restart','answerRestart','chunk','data'])
          && (
            resource.data.senderId == request.auth.uid
            || msgId == 'call_current'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
          );
        allow delete: if false;
      }
    }
  }
}
